#!/usr/bin/env bash
# claw-drive-approver — PreToolUse hook for claude-driven sessions.
#
# Invocation: registered in a session's settings.json as:
#   {"hooks":{"PreToolUse":[{"matcher":"*","hooks":[{
#     "type":"command",
#     "command":"/abs/path/to/bin/claw-drive-approver <session_id>",
#     "timeout":600
#   }]}]}}
#
# Contract:
#   - Reads the PreToolUse JSON payload from stdin (claude provides it).
#   - Forwards it to the per-session runner via ~/.claw-drive/sessions/<id>/control.sock
#     as {"id":"h_<nonce>","op":"approve_tool","pretooluse":<raw>}.
#   - Runner matches policy → returns {"ok":true,"result":{"behavior":"allow"|"deny",...}}.
#   - Translates the verdict to claude's hookSpecificOutput envelope and exits
#     0 (allow) or 2 (deny). The reason reaches jq on stdin, never as a
#     command-line argument (Linux caps one argument at 128 KiB).
#   - Self-times-out at 595s. On runner unreachable, on timeout, and on ANY
#     failure of its own (a failed command, a missing dependency), fails
#     secure: exits 2 with a deny envelope — because claude's default for a
#     hook that times out or exits without a decision is ALLOW, and we must
#     never let that slip policy.
#
# Runtime deps: jq, nc with -U (OpenBSD nc or nmap ncat).

set -euo pipefail

# Every decision leaves through emit_envelope. $1 is allow|deny; the reason is
# read from stdin as one raw string (-R -s), so only memory bounds its size.
# The CALLER sets `emitted` afterwards: the function runs as the tail of a
# pipeline, i.e. in a subshell, where an assignment would not survive. A
# failed write exits through the trap (`|| exit 2`), so the fallback goes out
# even where `set -e` is off.
emitted=0
emit_envelope() {
  jq -Rsc --arg d "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:$d,permissionDecisionReason:.}}'
}

# Deny with a fixed reason and exit 2.
deny() {
  printf '%s' "$1" | emit_envelope deny || exit 2
  emitted=1
  exit 2
}

# Fail secure on any exit that has not emitted a decision: a command failing
# under set -e, an unbound variable under set -u, jq missing from PATH. The
# fallback envelope is a literal — it must not depend on jq.
on_exit() {
  if (( emitted == 0 )); then
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"approver: internal failure — fail-secure deny"}}'
    exit 2
  fi
}
trap on_exit EXIT

SESSION_ID="${1:-}"
if [[ -z "$SESSION_ID" ]]; then
  deny "approver: session_id argument missing"
fi

SOCKET="${CLAW_DRIVE_HOME:-$HOME/.claw-drive}/sessions/$SESSION_ID/control.sock"

if [[ ! -S "$SOCKET" ]]; then
  deny "approver: control socket missing at $SOCKET"
fi

# Pick a Unix-socket-capable nc. Prefer ncat (nmap) for portability; fall back
# to OpenBSD nc. Both support -U for Unix sockets.
#
# IMPORTANT: do NOT use -N (OpenBSD) or --recv-only (ncat). The runner handler
# is async; it writes the response after awaiting emitEvent. If nc sends a FIN
# (via -N) before the response arrives, nc has already closed its read side and
# the response is lost. We instead rely on `head -n1` (below) to close the
# pipeline once one response line is received, which terminates nc naturally.
NC=""
if command -v ncat >/dev/null 2>&1; then
  NC="ncat -U"
elif command -v nc >/dev/null 2>&1; then
  NC="nc -U"
else
  deny "approver: neither ncat nor nc found on PATH"
fi

# Read the PreToolUse payload from stdin. Expect a single JSON object, possibly
# with trailing newline. Trim surrounding whitespace; no validation here.
payload=$(cat)

if [[ -z "$payload" ]]; then
  deny "approver: empty stdin payload"
fi

req_id="h_$$_$(date +%s%N)"

# Build envelope. `payload` is already a JSON object — we interpolate it raw.
# Using printf with %s for the payload preserves its structure verbatim.
req=$(printf '{"id":"%s","op":"approve_tool","pretooluse":%s}' "$req_id" "$payload")

# 595s timeout keeps us under claude's 600s hook ceiling (fail-secure).
# On timeout, the `timeout` command kills nc and returns 124.
# We classify the failure by elapsed time rather than exit code: nc
# connect-failures complete in milliseconds; full-timeout kills happen at ~$APPROVER_TIMEOUT s.
APPROVER_TIMEOUT=595
SPLIT_THRESHOLD_S=5

start_ns=$(date +%s%N)
resp=$(printf '%s\n' "$req" | timeout "$APPROVER_TIMEOUT" $NC "$SOCKET" 2>/dev/null | head -n1) || {
  end_ns=$(date +%s%N)
  elapsed_s=$(( (end_ns - start_ns) / 1000000000 ))
  if (( elapsed_s < SPLIT_THRESHOLD_S )); then
    deny "approver: runner unreachable (socket: $SOCKET) — runner may have crashed; check 'claw-drive sessions'"
  else
    deny "approver: gate unresolved within ${APPROVER_TIMEOUT}s — fail-secure deny (the human did not resolve in time)"
  fi
}

if [[ -z "$resp" ]]; then
  deny "approver: runner returned empty response"
fi

# Parse the runner's response. Expected shape:
#   {"id":"...","ok":true,"result":{"behavior":"allow"|"deny","message":"..."}}
# or {"id":"...","ok":false,"error":"...","message":"..."}
ok=$(jq -r '.ok // false' <<<"$resp")
if [[ "$ok" != "true" ]]; then
  err_code=$(jq -r '.error // "unknown"' <<<"$resp")
  err_msg=$(jq -r '.message // ""' <<<"$resp")
  deny "approver: runner error $err_code: $err_msg"
fi

behavior=$(jq -r '.result.behavior // "deny"' <<<"$resp")
# `$(...)` strips every trailing newline. `jq -j` prints the reason plus one
# sentinel byte and no newline of its own; the next line removes exactly that
# byte, so a reason's trailing newlines survive. (A NUL byte cannot survive a
# bash variable.)
reason=$(jq -j '(.result.message // "") + "\u0001"' <<<"$resp")
reason="${reason%$'\1'}"

if [[ "$behavior" == "allow" ]]; then
  printf '%s' "${reason:-allowed}" | emit_envelope allow || exit 2
  emitted=1
  exit 0
fi

printf '%s' "${reason:-denied}" | emit_envelope deny || exit 2
emitted=1
exit 2
